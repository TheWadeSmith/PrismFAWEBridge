diff --git a/prism-core/src/test/java/org/prism_mc/prism/core/storage/adapters/sql/ModificationOrderingTest.java b/prism-core/src/test/java/org/prism_mc/prism/core/storage/adapters/sql/ModificationOrderingTest.java
