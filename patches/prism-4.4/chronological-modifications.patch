+package org.prism_mc.prism.core.storage.adapters.sql;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.prism_mc.prism.core.storage.adapters.sql.AbstractSqlStorageAdapter.PRISM_ACTIVITIES;
+import static org.prism_mc.prism.core.storage.adapters.sql.AbstractSqlStorageAdapter.PRISM_DATABASE;
+
+import java.nio.file.Path;
+import java.sql.Connection;
+import java.sql.DriverManager;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.logging.Logger;
+import org.jooq.DSLContext;
+import org.jooq.Record;
+import org.jooq.Result;
+import org.jooq.SQLDialect;
+import org.jooq.conf.Settings;
+import org.jooq.impl.DSL;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.prism_mc.prism.api.activities.ActivityQuery;
+import org.prism_mc.prism.loader.services.configuration.ConfigurationService;
+
+/** Exercises the real SQL used by both stages of a streamed modification. */
+class ModificationOrderingTest {
+
+    @TempDir
+    Path configurationDirectory;
+
+    private Connection connection;
+    private SqlActivityQueryBuilder queries;
+
+    @BeforeEach
+    void createHistory() throws Exception {
+        AbstractSqlStorageAdapter.initializeDataObjects("prism_", "", "");
+        connection = DriverManager.getConnection("jdbc:sqlite::memory:");
+        DSLContext database = DSL.using(connection, SQLDialect.SQLITE, new Settings().withRenderSchema(false));
+        for (var table : PRISM_DATABASE.getTables()) {
+            database.createTable(table).columns(table.fields()).execute();
+        }
+        database.execute("insert into prism_worlds(world_id, world, world_uuid) values (1, 'world', '00000000-0000-0000-0000-000000000001')");
+        database.execute("insert into prism_actions(action_id, action) values (1, 'fawe-change'), (2, 'block-break')");
+        database.execute("insert into prism_blocks(block_id, ns, name, data) values (1, 'minecraft', 'stone', ''), (2, 'minecraft', 'weeping_vines', '')");
+
+        // One coordinate changes between ordinary/hanging materials. The last
+        // record is a native break after the FAWE writes. IDs deliberately do
+        // not track time; two events share a second and need the ID tie-break.
+        database.execute("insert into prism_activities(activity_id, timestamp, world_id, x, y, z, action_id, affected_block_id, reversed) values "
+            + "(31, 100, 1, 0, 80, 0, 1, 1, 0),"
+            + "(41, 200, 1, 0, 80, 0, 1, 2, 0),"
+            + "(42, 200, 1, 0, 80, 0, 1, 1, 0),"
+            + "(11, 300, 1, 0, 80, 0, 2, 1, 0)");
+
+        var configuration = new ConfigurationService(configurationDirectory, Logger.getAnonymousLogger());
+        queries = new SqlActivityQueryBuilder(configuration, database);
+    }
+
+    @AfterEach
+    void closeDatabase() throws Exception {
+        if (connection != null) {
+            connection.close();
+        }
+    }
+
+    @Test
+    void rollbackReversesMixedHistoryNewestFirst() {
+        assertEquals(List.of(11L, 42L, 41L, 31L), queries.queryActivityPks(ActivityQuery.builder().rollback().build()));
+    }
+
+    @Test
+    void restoreReplaysMixedHistoryOldestFirst() {
+        assertEquals(List.of(31L, 41L, 42L, 11L), queries.queryActivityPks(ActivityQuery.builder().restore().build()));
+    }
+
+    @Test
+    void rollbackRefetchRetainsChronologyRegardlessOfInListOrder() {
+        var result = queries.queryActivitiesByPks(List.of(31L, 11L, 41L, 42L), ActivityQuery.builder().rollback().build());
+        assertEquals(List.of(11L, 42L, 41L, 31L), ids(result));
+    }
+
+    @Test
+    void restoreRefetchRetainsChronologyRegardlessOfInListOrder() {
+        var result = queries.queryActivitiesByPks(List.of(42L, 11L, 31L, 41L), ActivityQuery.builder().restore().build());
+        assertEquals(List.of(31L, 41L, 42L, 11L), ids(result));
+    }
+
+    @Test
+    void streamedRollbackMatchesMaterializedHistoryAcrossBatches() {
+        assertBatches(ActivityQuery.builder().rollback().build(), List.of(11L, 42L, 41L, 31L));
+    }
+
+    @Test
+    void streamedRestoreMatchesMaterializedHistoryAcrossBatches() {
+        assertBatches(ActivityQuery.builder().restore().build(), List.of(31L, 41L, 42L, 11L));
+    }
+
+    @Test
+    void rollbackLimitSelectsNewestEventsBeforeSpatialPriorities() {
+        assertEquals(List.of(11L, 42L), queries.queryActivityPks(ActivityQuery.builder().rollback().limit(2).build()));
+    }
+
+    @Test
+    void restoreLimitSelectsOldestEventsBeforeSpatialPriorities() {
+        assertEquals(List.of(31L, 41L), queries.queryActivityPks(ActivityQuery.builder().restore().limit(2).build()));
+    }
+
+    private void assertBatches(ActivityQuery query, List<Long> expected) {
+        var keys = queries.queryActivityPks(query);
+        var streamed = new ArrayList<Long>();
+        for (int start = 0; start < keys.size(); start += 2) {
+            streamed.addAll(ids(queries.queryActivitiesByPks(keys.subList(start, Math.min(start + 2, keys.size())), query)));
+        }
+        assertEquals(expected, streamed);
+        assertEquals(ids(queries.queryActivities(query)), streamed);
+    }
+
+    private List<Long> ids(Result<Record> rows) {
+        return rows.getValues(PRISM_ACTIVITIES.ACTIVITY_ID).stream().map(Number::longValue).toList();
+    }
+}
